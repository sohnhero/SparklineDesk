# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://macbookpro@localhost:5432/sparkline_desk"

# Application Session Secret (Random 32+ character string)
AUTH_SECRET="sparkline-desk-super-secret-key-change-in-production-2026"

# Node Environment
NODE_ENV="development"

# App Port
PORT=3000

# Next Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email Provider (Leave blank to use dev console logger)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sparkline <contact@sparkline.sn>"

# Optional Storage Provider (Leave blank to use local filesystem storage)
STORAGE_PROVIDER="local"
